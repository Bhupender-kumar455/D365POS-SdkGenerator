<Window x:Class="D365SdkGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D365 Commerce SDK Generator"
        Width="1040"
        Height="940"
        MinWidth="940"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Icon="Assets/app.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnWindowLoaded"
        Activated="OnWindowActivated"
        Closing="OnWindowClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Top bar ============================ -->

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Height="58">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="26"
                        Height="26"
                        CornerRadius="7"
                        Background="{DynamicResource MarkBrush}"
                        VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconStack}"
                                  Stroke="{DynamicResource MarkGlyphBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="Commerce SDK Generator"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource ChipBrush}"
                            BorderBrush="{DynamicResource ChipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1,6,3"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v2"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource ChipBrush}"
                            BorderBrush="{DynamicResource ChipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,3,9,4"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SDK"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock x:Name="SdkPill"
                                       Text="SDK"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ThemeToggleButton"
                            Tag="{StaticResource IconMoon}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Switch to dark theme"
                            AutomationProperties.AutomationId="ThemeToggle"
                            Click="OnThemeToggleClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Content ============================ -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="24,26,24,12">

                <!-- Hero -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0" />
                        <TextBlock Text="STORE COMMERCE + SCALE UNIT"
                                   Style="{StaticResource MicroLabel}" />
                    </StackPanel>

                    <TextBlock Text="Create a new project"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="Generate a packaging solution that is ready to build, sign and deploy."
                               FontSize="13.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>

                <!-- Project card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <Grid Margin="22,16,22,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Project details"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Names and locations used across the generated solution."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Viewbox Grid.Column="1"
                                     Width="18"
                                     Height="18"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconBox}"
                                          Style="{StaticResource FieldIcon}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <Border Style="{StaticResource HairlineStyle}" />

                        <Grid Margin="22,16,22,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Project name -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconBox}"
                                                  Style="{StaticResource FieldIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <TextBox x:Name="ProjectNameBox"
                                         Style="{StaticResource FieldTextBox}"
                                         TextChanged="OnFieldChanged"
                                         SpellCheck.IsEnabled="False"
                                         AutomationProperties.AutomationId="ProjectNameBox"
                                         ToolTip="Used for the solution, projects, packages and namespaces." />
                                <TextBlock x:Name="ProjectNameError" Style="{StaticResource FieldErrorText}" />
                            </StackPanel>

                            <!-- Publisher -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconShield}"
                                                  Style="{StaticResource FieldIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Publisher" Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <TextBox x:Name="PublisherBox"
                                         Style="{StaticResource FieldTextBox}"
                                         TextChanged="OnFieldChanged"
                                         SpellCheck.IsEnabled="False"
                                         AutomationProperties.AutomationId="PublisherBox"
                                         ToolTip="Written to the package manifest and the signing certificate subject." />
                                <TextBlock x:Name="PublisherError" Style="{StaticResource FieldErrorText}" />
                            </StackPanel>

                            <!-- Commerce SDK -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconStack}"
                                                  Style="{StaticResource FieldIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Commerce SDK" Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <ComboBox x:Name="SdkCombo"
                                          Style="{StaticResource FieldComboBox}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.AutomationId="SdkCombo"
                                          SelectionChanged="OnSelectionChanged" />
                            </StackPanel>

                            <!-- Output folder -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconFolder}"
                                                  Style="{StaticResource FieldIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputBox"
                                             Style="{StaticResource FieldTextBox}"
                                             TextChanged="OnFieldChanged"
                                             SpellCheck.IsEnabled="False"
                                             AutomationProperties.AutomationId="OutputBox" />
                                    <Button x:Name="BrowseButton"
                                            Grid.Column="1"
                                            Content="Browse"
                                            Tag="{StaticResource IconFolder}"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="36"
                                            Padding="13,0"
                                            Margin="8,0,0,0"
                                            Click="OnBrowseClick" />
                                </Grid>
                                <TextBlock x:Name="OutputError" Style="{StaticResource FieldErrorText}" />
                            </StackPanel>

                            <!-- Options -->
                            <CheckBox x:Name="GitCheck"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Style="{StaticResource FieldCheckBox}"
                                      Content="Initialize a Git repository"
                                      IsChecked="True"
                                      Margin="0,12,0,0"
                                      AutomationProperties.AutomationId="GitCheck"
                                      Checked="OnOptionChanged"
                                      Unchecked="OnOptionChanged" />
                        </Grid>

                        <!-- Build requirements: what the generated solution needs in order to build -->
                        <Border Padding="22,12,22,12"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconChecklist}"
                                                  Style="{StaticResource FieldIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Build requirements"
                                               Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="· needed to build the generated solution"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </StackPanel>

                                <TextBlock x:Name="RequirementsLoadingText"
                                           Text="Checking .NET SDK and Node.js…"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="21,8,0,0" />

                                <ItemsControl x:Name="RequirementList"
                                              Margin="21,9,0,0"
                                              Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RequirementChip}"
                                                    Tag="{Binding ActionUrl}"
                                                    Margin="0,0,6,6"
                                                    ToolTip="{Binding Tip}"
                                                    ToolTipService.ShowDuration="30000"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    AutomationProperties.HelpText="{Binding Tip}"
                                                    Click="OnRequirementActionClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresent}"
                                                                                 Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Version}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresent}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Download/Fix action, only for missing tools -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="7,0,0,0"
                                                                Visibility="{Binding ActionVisibility}">
                                                        <Viewbox Width="10"
                                                                 Height="10"
                                                                 Margin="0,0,4,0"
                                                                 VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{StaticResource IconDownload}"
                                                                      Stroke="{DynamicResource AccentBrush}"
                                                                      StrokeThickness="2"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding ActionLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Preflight notices; only rendered when something needs attention -->
                        <StackPanel x:Name="PreflightPanel"
                                    Visibility="Collapsed"
                                    Margin="22,0,22,12">
                            <ItemsControl x:Name="PreflightList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="7"
                                                Padding="11,9"
                                                Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         VerticalAlignment="Top"
                                                         Margin="0,5,9,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Fill"
                                                                            Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Fill"
                                                                            Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Fix}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Visibility="{Binding FixVisibility}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="ShortRootButton"
                                    Style="{StaticResource LinkButton}"
                                    Content="Use a short output folder (C:\D365) instead"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed"
                                    Click="OnUseShortRootClick" />
                        </StackPanel>

                        <Border Style="{StaticResource HairlineStyle}" />

                        <Grid Margin="22,12,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="CREATES" Style="{StaticResource MicroLabel}" />
                                <TextBlock x:Name="CreatesText"
                                           Text="Complete the fields above"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="OpenSolutionButton"
                                        Content="Open solution"
                                        Tag="{StaticResource IconWindow}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="OnOpenSolutionClick" />
                                <Button x:Name="OpenFolderButton"
                                        Content="Open folder"
                                        Tag="{StaticResource IconFolder}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="OnOpenFolderClick" />
                                <Button x:Name="CancelButton"
                                        Content="Cancel"
                                        Tag="{StaticResource IconClose}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="CancelButton"
                                        Visibility="Collapsed"
                                        Click="OnCancelClick" />
                                <Button x:Name="GenerateButton"
                                        Content="Generate project"
                                        Tag="{StaticResource IconSparkle}"
                                        Style="{StaticResource PrimaryButton}"
                                        AutomationProperties.AutomationId="GenerateButton"
                                        IsDefault="True"
                                        Click="OnGenerateClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Activity -->
                <Border Style="{StaticResource CardStyle}"
                        Height="212"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,12,16,11">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconLog}"
                                              Style="{StaticResource FieldIcon}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Activity"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="· generator output"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="LogCountText"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Button x:Name="ClearLogButton"
                                        Content="Clear"
                                        Tag="{StaticResource IconTrash}"
                                        Style="{StaticResource IconLinkButton}"
                                        VerticalAlignment="Center"
                                        Click="OnClearLogClick" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource LogBackgroundBrush}"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10">
                            <Grid>
                                <ListBox x:Name="LogList" Style="{StaticResource LogListStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <Ellipse Grid.Column="1"
                                                         Width="5"
                                                         Height="5"
                                                         VerticalAlignment="Top"
                                                         Margin="0,7,0,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource LogInfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                                    <Setter Property="Fill"
                                                                            Value="{DynamicResource LogSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                    <Setter Property="Fill"
                                                                            Value="{DynamicResource LogWarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Error">
                                                                    <Setter Property="Fill"
                                                                            Value="{DynamicResource LogErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Message}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource LogInfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource LogSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource LogWarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Error">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource LogErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="EmptyLogHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconTerminal}"
                                                  Stroke="{DynamicResource TextFaintBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Generation output appears here."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ Footer ============================ -->

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,9,24,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="Progress"
                             Style="{StaticResource ThinProgress}"
                             IsIndeterminate="False"
                             Margin="0,0,0,9" />

                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="7"
                                 Height="7"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Generation runs locally · Nothing is uploaded"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
