<Window x:Class="D365SdkGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D365 Commerce SDK Generator"
        Width="1020"
        Height="860"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Icon="Assets/app.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->

        <Grid Grid.Row="0" Margin="28,24,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    CornerRadius="11"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">
                <Viewbox Width="23" Height="23">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 L21,7.5 L12,12 L3,7.5 Z M3,7.5 L3,16.5 L12,21 L21,16.5 L21,7.5 M12,12 L12,21"
                              Stroke="White"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="D365 Commerce SDK Generator"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Store Commerce + Scale Unit packaging solution"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="20"
                    Padding="12,4,12,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5"
                             Height="5"
                             Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0" />
                    <TextBlock x:Name="SdkPill"
                               Text="SDK"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================ Content ============================ -->

        <Grid Grid.Row="1" Margin="28,0,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- Form -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <StackPanel Margin="24,20,24,18">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Commerce SDK" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SdkCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource FieldComboBox}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnSelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="ProjectNameBox"
                                     Style="{StaticResource FieldTextBox}"
                                     TextChanged="OnFieldChanged"
                                     SpellCheck.IsEnabled="False"
                                     ToolTip="Used for the solution, projects, packages and namespaces." />
                            <TextBlock x:Name="ProjectNameError" Style="{StaticResource FieldErrorText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Publisher" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="PublisherBox"
                                     Style="{StaticResource FieldTextBox}"
                                     TextChanged="OnFieldChanged"
                                     SpellCheck.IsEnabled="False"
                                     ToolTip="Written to the package manifest and the signing certificate subject." />
                            <TextBlock x:Name="PublisherError" Style="{StaticResource FieldErrorText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputBox"
                                         Style="{StaticResource FieldTextBox}"
                                         TextChanged="OnFieldChanged"
                                         SpellCheck.IsEnabled="False" />
                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="36"
                                        Padding="14,0"
                                        Margin="8,0,0,0"
                                        Click="OnBrowseClick" />
                            </Grid>
                            <TextBlock x:Name="OutputError" Style="{StaticResource FieldErrorText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="GitCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource FieldCheckBox}"
                                  Content="Initialize a Git repository"
                                  IsChecked="True"
                                  Checked="OnOptionChanged"
                                  Unchecked="OnOptionChanged" />
                    </Grid>

                    <StackPanel x:Name="PreflightPanel" Visibility="Collapsed" Margin="0,10,0,4">
                        <ItemsControl x:Name="PreflightList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Backdrop}"
                                            CornerRadius="7"
                                            Padding="11,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{Binding Accent}"
                                                     VerticalAlignment="Top"
                                                     Margin="0,5,9,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Accent}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Fix}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding FixVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ShortRootButton"
                                Style="{StaticResource LinkButton}"
                                Content="Use a short output folder (C:\D365) instead"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                Visibility="Collapsed"
                                Click="OnUseShortRootClick" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="CREATES"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="CreatesText"
                                       Text="Complete the fields above"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenSolutionButton"
                                    Content="Open solution"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="OnOpenSolutionClick" />
                            <Button x:Name="OpenFolderButton"
                                    Content="Open folder"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="OnOpenFolderClick" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="OnCancelClick" />
                            <Button x:Name="GenerateButton"
                                    Content="Generate project"
                                    Style="{StaticResource PrimaryButton}"
                                    IsDefault="True"
                                    Click="OnGenerateClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Activity -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,13,16,11">
                        <TextBlock Text="Activity"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ClearLogButton"
                                Content="Clear"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnClearLogClick" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource LogBackgroundBrush}"
                            BorderBrush="{StaticResource SeparatorBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10">
                        <Grid>
                            <ListBox x:Name="LogList" Style="{StaticResource LogListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0" />
                                            <Ellipse Grid.Column="1"
                                                     Width="5"
                                                     Height="5"
                                                     Fill="{Binding Foreground}"
                                                     VerticalAlignment="Top"
                                                     Margin="0,7,0,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Message}"
                                                       FontSize="12"
                                                       Foreground="{Binding Foreground}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="EmptyLogHint"
                                       Text="Generation output appears here."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->

        <Grid Grid.Row="2" Margin="28,0,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="Progress"
                         Style="{StaticResource ThinProgress}"
                         IsIndeterminate="False"
                         Margin="0,0,0,9" />

            <Grid Grid.Row="1">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Generation runs locally. Nothing is uploaded."
                           FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>
