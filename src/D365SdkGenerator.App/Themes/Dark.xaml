<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark palette. Keys must stay in sync with Light.xaml; ThemeService swaps the whole
        dictionary, so Styles.xaml only ever refers to keys with DynamicResource.
    -->

    <Color x:Key="ShadowColor">#66000000</Color>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="CardBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#262626" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1A1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#3F3F46" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#525252" />
    <SolidColorBrush x:Key="InputDisabledBrush" Color="#111111" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3291FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0E2A47" />

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="#6E6E6E" />

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#222222" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#EDEDED" />

    <SolidColorBrush x:Key="HoverBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PressedBrush" Color="#222222" />

    <SolidColorBrush x:Key="ChipBrush" Color="#111111" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#262626" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#141414" />

    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#050505" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F85149" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#333333" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1F1F1F" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0D2318" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#241C0C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A1214" />

    <SolidColorBrush x:Key="MarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MarkGlyphBrush" Color="#000000" />

    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#EDEDED" />

</ResourceDictionary>
