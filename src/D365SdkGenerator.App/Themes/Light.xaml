<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette. Every brush used by Styles.xaml and MainWindow.xaml lives here so the
        whole theme can be swapped by replacing this dictionary at runtime.
    -->

    <Color x:Key="ShadowColor">#24000000</Color>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#EAEAEA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8F8F8F" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#C7C7C7" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="InputDisabledBrush" Color="#FAFAFA" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0070F3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2FF" />

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#000000" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="#A8A8A8" />

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#000000" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="PressedBrush" Color="#EAEAEA" />

    <SolidColorBrush x:Key="ChipBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F5F5F5" />

    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#383838" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#383838" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#067647" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#B54708" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#D92D20" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="TrackBrush" Color="#EAEAEA" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#067647" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EDFCF3" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B54708" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF8E8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF3F2" />

    <SolidColorBrush x:Key="MarkBrush" Color="#000000" />
    <SolidColorBrush x:Key="MarkGlyphBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#FFFFFF" />

</ResourceDictionary>
